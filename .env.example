NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Needed for importing other universities' timetables (/api/extract, /api/university). Free tier is enough.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Regulation answers stay extractive unless this is "true" (then they are summarised by the model above).
# ASK_LLM=true
EMBEDDING_PROVIDER=local
# Local-only LLM for evals: FreeLLMAPI router on 127.0.0.1 (never set on Vercel).
# LLM_PROVIDER=freellmapi
# FREELLMAPI_KEY=
# FREELLMAPI_MODEL=typhoon-2.5-30b-a3b-instruct

# Show "Continue with Google" once the Google provider is set up in Supabase (see supabase/config.toml).
# AUTH_GOOGLE_ENABLED=true
